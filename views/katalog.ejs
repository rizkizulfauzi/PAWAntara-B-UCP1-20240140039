<!DOCTYPE html>
<html lang="id">

<head>
  <%- include("partials/head") %>
</head>

<body>

  <%- include("partials/navbar") %>

  <main>

    <!-- =========================
         HEADER KATALOG
         ========================= -->
    <section class="section">

      <div class="container">

        <p class="eyebrow">
          Katalog
        </p>

        <h1>
          Produk Toko Ariesta
        </h1>

        <p>
          Temukan berbagai kebutuhan sembako
          dengan harga dan stok yang selalu diperbarui.
        </p>

      </div>

    </section>


    <!-- =========================
         FILTER & SEARCH
         ========================= -->
    <section class="section">

      <div class="container">

        <form
          id="filter-form"
          class="filter-form"
        >

          <div class="form-group">

            <label for="search">
              Cari Produk
            </label>

            <input
              type="search"
              id="search"
              name="search"
              placeholder="Contoh: beras"
            >

          </div>


          <div class="form-group">

            <label for="kategori">
              Kategori
            </label>

            <select
              id="kategori"
              name="kategori"
            >

              <option value="">
                Semua Kategori
              </option>

              <option value="beras">
                Beras
              </option>

              <option value="minyak">
                Minyak
              </option>

              <option value="gula">
                Gula
              </option>

              <option value="sembako">
                Sembako
              </option>

            </select>

          </div>


          <button
            type="submit"
            class="btn btn--primary"
          >
            Cari Produk
          </button>

        </form>

      </div>

    </section>


    <!-- =========================
         DAFTAR PRODUK
         ========================= -->
    <section class="section">

      <div class="container">

        <div
          id="product-list"
          class="product-grid"
        >
          <!-- Produk akan dimasukkan
               melalui Fetch API -->
        </div>


        <p
          id="empty-message"
          hidden
        >
          Produk tidak ditemukan.
        </p>

      </div>

    </section>

  </main>


  <%- include("partials/footer") %>


  <!-- JavaScript Fetch API -->
  <script src="/js/katalog.js"></script>

</body>

</html>