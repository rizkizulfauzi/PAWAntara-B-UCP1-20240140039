<!DOCTYPE html>
<html lang="id">
<head><%- include('partials/head') %></head>
<body>
  <%- include('partials/navbar') %>
  <main class="section section--narrow">
    <p class="eyebrow">Bantuan cepat</p><h1>Tanya AI</h1><p class="hero__lead">Tanyakan harga, stok, jam buka, ongkir, atau pembayaran. Balasan diproses oleh logika dummy di backend Express.</p>
    <section class="chat" aria-label="Riwayat percakapan"><ul id="chat-log" class="chat__log"><li class="bubble bubble--ai">Halo! Ada yang bisa dibantu seputar Toko Ariesta?</li></ul></section>
    <form id="chat-form" class="chat-form" aria-label="Form Tanya AI"><label class="sr-only" for="chat-message">Tulis pertanyaan kamu</label><input id="chat-message" name="message" required placeholder="Contoh: gula sekilo berapa?" /><button class="btn btn--primary" type="submit">Kirim</button></form>
    <div class="chips"><button type="button" class="chip" data-message="Toko buka jam berapa?">Jam buka?</button><button type="button" class="chip" data-message="Bisa antar?">Bisa antar?</button><button type="button" class="chip" data-message="Berapa harga gula?">Harga gula?</button></div>
  </main>
  <%- include('partials/footer') %>
  <script src="/js/chat.js"></script>
</body>
</html>
